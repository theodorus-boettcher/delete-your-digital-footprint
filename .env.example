# Copy to .env (git-ignored). `art15 setup` asks for anything missing.
ART15_NAME=
ART15_EMAIL=
# Gmail: Google account > Security > 2-Step Verification > App passwords
ART15_APP_PASSWORD=
ART15_IMAP_HOST=imap.gmail.com
# Two-letter country code, picks your data protection authority for complaints (e.g. it, de)
ART15_COUNTRY=
# Only needed when your country has several authorities (Germany): a slug from data/datenanfragen/supervisory-authorities
ART15_AUTHORITY=
# Letter language when the company record has none (en, de, it, fr, es, nl, ...)
ART15_LANG=en
# Local models (Ollama)
ART15_MODEL=qwen3:8b
ART15_VLM=qwen2.5vl:3b
# Cloud model, used only with --allow-cloud (any OpenAI-compatible endpoint)
ART15_CLOUD_URL=
ART15_CLOUD_KEY=
ART15_CLOUD_MODEL=
# Jev (TypeSafe AI), used only with --jev: an OpenRouter key works (TypeSafe paused its own signups).
# For TypeSafe's own API: ART15_JEV_URL=https://api.typesafe.ai/v1/systemone and ART15_JEV_MODEL=jev-1.13.0
ART15_JEV_KEY=
ART15_JEV_URL=https://openrouter.ai/api/alpha/decisions
ART15_JEV_MODEL=typesafe/jev-1.14
# A reply label from Jev counts only at or above this probability; below it, you read the reply.
ART15_JEV_THRESHOLD=0.8
